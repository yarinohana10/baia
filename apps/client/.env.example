# ─────────────────────────────────────────────────────────────────────────────
# BAIA storefront (apps/client) - copy to apps/client/.env.local for local dev.
# Full reference: docs/railway-env.md. `next build` validates these
# (src/lib/env.ts) and fails a production build with the complete list.
# NEXT_PUBLIC_* are inlined at BUILD time.
# ─────────────────────────────────────────────────────────────────────────────

# Public storefront origin (canonical URLs, sitemap, robots, OG). Required for production builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local dev (direct): the browser calls the API origin.
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_AUTH_URL=http://localhost:8000

# Production on Railway (same-origin proxy; first-party session cookie):
#   NEXT_PUBLIC_API_URL=/v1
#   NEXT_PUBLIC_AUTH_URL=            (empty -> NEXT_PUBLIC_SITE_URL)
#   API_INTERNAL_URL=http://${{server.RAILWAY_PRIVATE_DOMAIN}}:8000   (build AND runtime)
# API_INTERNAL_URL=

# Server-only overrides for SSR fetches (rarely needed; derived from API_INTERNAL_URL)
# API_URL=
# AUTH_URL=

# Image hosts next/image may optimise (comma-separated URLs, e.g. your R2/CDN domain). Build time.
# IMAGE_REMOTE_PATTERNS=https://images.baia.co.il

# Store logo in the assets bucket (printed by apps/server/scripts/brand-assets.ts).
# Unset: the bundled /logo/baia-logo.png. Its host must be in IMAGE_REMOTE_PATTERNS.
# LOGO_URL=https://images.baia.co.il/site/brand/baia-logo-<hash>.png

# Optional
# NEXT_PUBLIC_AUTH_COOKIE_PREFIX=baia
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_TRACKING_URL_TEMPLATE=https://carrier.example/track?n={tracking}
