# ─────────────────────────────────────────────────────────────────────────────
# BAIA API (apps/server) - copy to apps/server/.env for local development.
# Every variable, with production rules and Railway values: docs/railway-env.md
# The server validates this at boot (src/config/env.ts); NODE_ENV=production
# refuses to start and lists every missing/invalid variable.
# Never commit real secrets. .env is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://baia:baia@localhost:5433/baia?schema=public
# Express "trust proxy": hops in front of the API (Railway = 1). Default: 1 in production, off in dev.
# TRUST_PROXY=1
# Max JSON/form body (uploads have their own 10 MB limit). Default 1mb.
# BODY_LIMIT=1mb

# ── Origins / auth (better-auth) ─────────────────────────────────────────────
# Storefront origin(s), comma separated. First one is used for links in emails. Used for CORS + auth.
CLIENT_URL=http://localhost:3000
# Extra comma-separated browser origins allowed for CORS/auth (e.g. Storybook).
# TRUSTED_ORIGINS=
# Public origin the BROWSER uses for /api/auth:
#   local dev / custom API domain -> the API origin;  Railway same-origin proxy -> the storefront origin.
BETTER_AUTH_URL=http://localhost:8000
# REQUIRED in production: >= 32 random chars (`openssl rand -base64 32`). Empty in dev = insecure dev secret.
BETTER_AUTH_SECRET=
AUTH_COOKIE_PREFIX=baia
# Only with a custom domain + API subdomain (e.g. .baia.co.il). Never a *.up.railway.app domain.
# AUTH_COOKIE_DOMAIN=
# Auth rate limiting (default: on, except under tests)
# AUTH_RATE_LIMIT=true
# Proxy IPs/CIDRs better-auth may strip from a multi-hop X-Forwarded-For (rarely needed).
# AUTH_TRUSTED_PROXIES=
# Google sign-in (optional; set both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bootstrap admin - read only by `pnpm prisma:seed` / `pnpm admin:create`. Never commit real values.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# ── Email ─────────────────────────────────────────────────────────────────────
# smtp | console (console = log recipient/subject only, nothing delivered)
EMAIL_PROVIDER=smtp
# Dev: Mailpit from docker-compose.infra.yml (UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# true = implicit TLS (port 465); otherwise STARTTLS is negotiated automatically (587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BAIA Swimwear <no-reply@baia.local>"
# Store inbox for new-order/cancellation alerts when Admin > Settings > contact email is empty
# ADMIN_NOTIFY_EMAIL=
# Retry schedule for failed sends, ms
# EMAIL_RETRY_DELAYS_MS=0,2000,8000

# ── Storage ───────────────────────────────────────────────────────────────────
# s3 (LocalStack in dev; REQUIRED in production) | local (dev only - lost on every container deploy)
STORAGE_PROVIDER=s3
UPLOADS_DIR=./uploads
S3_ENDPOINT=http://localhost:4566
# Public base URL images are served from (CDN_URL overrides it)
S3_PUBLIC_URL=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=baia-assets
# Path-style requests (auto for localhost endpoints; true for MinIO/LocalStack on other hosts)
# S3_FORCE_PATH_STYLE=
# false when S3_PUBLIC_URL/CDN_URL already points at the bucket (R2 public domain, CDN): url = <public>/<key>
# S3_PUBLIC_URL_INCLUDES_BUCKET=true
# CDN_URL=https://images.example.com

# ── Payments / orders ─────────────────────────────────────────────────────────
# Unset in dev = mock. REQUIRED in production; only "mock" exists today (no real charge!).
# PAYMENT_PROVIDER=mock
# PAYMENT_WEBHOOK_SECRET=
# MOCK_PAYMENT_DELAY_MS=500
# PAYMENT_INSTALLMENTS_MIN_TOTAL=300
# PENDING_ORDER_TTL_MINUTES=60
# ORDER_ACCESS_TOKEN_TTL_DAYS=30
# Carrier tracking link in "order shipped" emails ({tracking} = tracking number)
# TRACKING_URL_TEMPLATE=https://carrier.example/track?n={tracking}
# TRACKING_CARRIER_NAME=
# Absolute origin for relative image paths in emails (defaults to BETTER_AUTH_URL)
# SERVER_URL=
