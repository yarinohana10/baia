# Server
PORT=8000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://baia:baia@localhost:5433/baia?schema=public

# Auth (better-auth)
# BETTER_AUTH_SECRET is REQUIRED when NODE_ENV=production (>= 32 chars; `openssl rand -base64 32`).
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:8000
AUTH_COOKIE_PREFIX=baia
# Extra comma-separated origins allowed to call auth endpoints (CLIENT_URL is always trusted)
# TRUSTED_ORIGINS=
# Cookie domain to share the session between shop and API subdomains in production (e.g. .baiaswimwear.com)
# AUTH_COOKIE_DOMAIN=
# Rate limiting on auth endpoints (default: on, except under tests)
# AUTH_RATE_LIMIT=true

# Bootstrap admin — used by `pnpm prisma:seed` and `pnpm admin:create`. Never commit real values.
# The seed only creates/promotes this user; it never deletes users or changes an existing password.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# Email
# smtp = send via SMTP (Mailpit in dev: UI http://localhost:8025), console = log recipient/subject only
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# true = implicit TLS (port 465); STARTTLS is used automatically otherwise
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BAIA Swimwear <no-reply@baia.local>"
# Store inbox for order/cancellation alerts when Site settings > contact email is empty
# ADMIN_NOTIFY_EMAIL=orders@example.com
# Carrier tracking link in "order shipped" emails ({tracking} = tracking number); unset = number only
# TRACKING_URL_TEMPLATE=https://carrier.example/track?n={tracking}

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage (s3 = LocalStack in dev, local = filesystem fallback)
STORAGE_PROVIDER=s3
UPLOADS_DIR=./uploads

# S3 (used when STORAGE_PROVIDER=s3)
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_URL=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=baia-assets

# CDN (optional — overrides S3_PUBLIC_URL for serving images via CloudFront/Cloudflare)
# CDN_URL=https://cdn.yourdomain.com
