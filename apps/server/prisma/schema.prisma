generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (better-auth managed) ───────────────────────────────

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CUSTOMER)
  // Spam-law (חוק התקשורת 30א) opt-in for marketing email; never pre-ticked.
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  wishlistItems Wishlist[]
  carts         Cart[]
  orders        Order[]
  addresses     Address[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ─── Address book ─────────────────────────────────────────────

/// A saved shipping address. Fields mirror the shipping fields on Order.
/// At most one row per user has isDefault = true (kept by AddressesService).
model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  city          String
  street        String
  number        String
  apartment     String?
  zip           String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ─── Uploads ──────────────────────────────────────────────────

model Upload {
  id         String   @id @default(cuid())
  s3Key      String   @unique
  s3Bucket   String
  mimeType   String
  sizeBytes  Int
  fileName   String
  uploadedBy String?
  createdAt  DateTime @default(now())

  productImages ProductImage[]
  categories    Category[]

  @@map("uploads")
}

// ─── Catalog ──────────────────────────────────────────────────

model Category {
  id             String     @id @default(cuid())
  nameHe         String
  nameEn         String
  slug           String     @unique
  image          String?
  imageUploadId  String?
  imageUpload    Upload?    @relation(fields: [imageUploadId], references: [id])
  sortOrder      Int        @default(0)
  parentId       String?
  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  // Default size set for products in this category (inherited from parent when null)
  sizeSetId      String?
  sizeSet        SizeSet?   @relation(fields: [sizeSetId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryHierarchy")
  products       Product[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("categories")
}

model Product {
  id            String           @id @default(cuid())
  nameHe        String
  nameEn        String
  descriptionHe String?
  descriptionEn String?
  slug          String           @unique
  basePrice     Decimal          @db.Decimal(10, 2)
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  isFeatured    Boolean          @default(false)
  // false = Hidden: not visible on the storefront at all (admin "eye" control).
  isActive      Boolean          @default(true)
  // true = Back Soon: still visible but not purchasable, even if stock exists.
  backSoon      Boolean          @default(false)
  // Size set used for variant sizes; null = custom (free-text) sizes
  sizeSetId     String?
  sizeSet       SizeSet?         @relation(fields: [sizeSetId], references: [id], onDelete: SetNull)
  // Product-page content (all optional, bilingual)
  fabricHe      String?          // e.g. "82% ניילון ממוחזר, 18% ליקרה"
  fabricEn      String?
  careHe        String?
  careEn        String?
  fitHe         String?          // fit notes, e.g. "הדוגמנית לובשת M, גובה 1.75"
  fitEn         String?
  variants      ProductVariant[]
  images        ProductImage[]
  wishlistItems Wishlist[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("products")
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color         String
  size          String
  sku           String      @unique
  stockQuantity Int         @default(0)
  // false = unlimited stock: always purchasable, stockQuantity is ignored and never decremented
  trackInventory Boolean    @default(true)
  priceOverride Decimal?    @db.Decimal(10, 2)
  salePrice     Decimal?    @db.Decimal(10, 2)
  saleStart     DateTime?
  saleEnd       DateTime?
  isActive      Boolean     @default(true)
  // Stock-alert dedupe: set when an alert email was sent, cleared on restock above the threshold.
  lowStockNotifiedAt DateTime?
  soldOutNotifiedAt  DateTime?
  cartItems     CartItem[]
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([productId, color, size])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  uploadId  String?
  upload    Upload? @relation(fields: [uploadId], references: [id])
  color     String?
  altText   String? // legacy single-language alt text (kept for existing rows)
  altTextHe String?
  altTextEn String?
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// A named, ordered list of sizes (e.g. adult letter sizes, kids ages).
// Data-driven: add rows to support new size systems without code changes.
model SizeSet {
  id         String     @id @default(cuid())
  key        String     @unique
  nameHe     String
  nameEn     String
  sizes      String[]
  sortOrder  Int        @default(0)
  categories Category[]
  products   Product[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("size_sets")
}

// ─── Wishlist ─────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

// ─── Cart ─────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ─── Orders ───────────────────────────────────────────────────

enum DeliveryMethod {
  COURIER
  PICKUP_POINT
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  customerEmail  String
  // Who receives the parcel; nullable only for orders placed before these were collected.
  recipientName  String?
  phone          String?
  // Storefront language at checkout; used for transactional emails.
  locale         String      @default("he")
  status         OrderStatus @default(PENDING_PAYMENT)
  subtotal       Decimal     @db.Decimal(10, 2)
  shippingCost   Decimal     @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  couponId       String?
  coupon         Coupon?     @relation(fields: [couponId], references: [id])
  trackingNumber String?
  paymentRef     String?
  items          OrderItem[]

  deliveryMethod  DeliveryMethod @default(COURIER)
  // Snapshot of the chosen pickup point (the shipping* fields hold its address).
  pickupPointId   String?
  pickupPointName String?
  // Shopper ticked the (unticked-by-default) marketing consent box at checkout.
  marketingConsent Boolean @default(false)

  // How the order was paid (filled from the payment provider's result).
  paymentMethod       String?  // "card" | "bit" | "apple_pay"
  paymentInstallments Int?
  cardBrand           String?
  cardLast4           String?

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  cancellationRequests CancellationRequest[]
  refunds       Refund[]
  statusEvents  OrderStatusEvent[]

  // Guest access: SHA-256 hash of a 256-bit random token returned once at
  // creation. The raw token is never stored. Null for logged-in orders.
  accessTokenHash      String?
  accessTokenExpiresAt DateTime?

  // Short-lived claim so concurrent /payment/charge calls cannot both reach
  // the provider. Cleared on failure; stale claims expire (see PaymentService).
  paymentClaimedAt DateTime?
  paymentAttempts  PaymentAttempt[]

  shippingCity      String
  shippingStreet    String
  shippingNumber    String
  shippingApartment String?
  shippingZip       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([deliveredAt])
  @@map("orders")
}

// Audit trail of every status change (who/when), written with the change itself.
model OrderStatusEvent {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  // Email of the admin or customer who triggered it; null for system changes (e.g. sweeper).
  changedByEmail String?
  createdAt     DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

// Money owed back to the customer for a cancelled paid order. Settled by the
// payment provider (automatically once one is integrated, manually until then).
model Refund {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id])
  amount           Decimal      @db.Decimal(10, 2)
  status           RefundStatus @default(PENDING)
  // The payment provider's refund id once settled.
  providerRef      String?
  note             String?
  requestedAt      DateTime     @default(now())
  completedAt      DateTime?
  completedByEmail String?

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// Admin rights granted by the Owner to an email without an Account yet;
// applied when that email registers and verifies.
model AdminInvitation {
  id             String   @id @default(cuid())
  email          String   @unique
  invitedByEmail String
  createdAt      DateTime @default(now())

  @@map("admin_invitations")
}

// ─── Payments ─────────────────────────────────────────────────

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model PaymentAttempt {
  id          String               @id @default(cuid())
  orderId     String
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  status      PaymentAttemptStatus @default(PENDING)
  amount      Decimal              @db.Decimal(10, 2)
  currency    String
  providerRef String?
  error       String?
  ipAddress   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([orderId])
  @@map("payment_attempts")
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  // Hebrew name snapshot (productName is English); null on older orders.
  productNameHe String?
  color       String
  size        String
  quantity    Int
  unitPrice   Decimal        @db.Decimal(10, 2)
  // Whether this line decremented variant stock (false for unlimited-stock variants),
  // so a cancel/refund restores exactly what was taken.
  stockDeducted Boolean      @default(true)
  createdAt   DateTime       @default(now())

  @@map("order_items")
}

// ─── Coupons ──────────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  discountType DiscountType
  value        Decimal      @db.Decimal(10, 2)
  minCartValue Decimal?     @db.Decimal(10, 2)
  maxUses      Int?
  currentUses  Int          @default(0)
  isActive     Boolean      @default(true)
  expiresAt    DateTime?
  orders       Order[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("coupons")
}

// ─── Site Config ──────────────────────────────────────────────

model SiteConfig {
  id                    String  @id @default("default")
  shippingCost          Decimal @default(29.90) @db.Decimal(10, 2)
  freeShippingThreshold Decimal @default(249) @db.Decimal(10, 2)
  heroImageUrl          String?
  heroImageUploadId     String?
  heroTitleHe           String?
  heroTitleEn           String?
  heroSubtitleHe        String?
  heroSubtitleEn        String?
  heroCtaUrl            String?

  // Delivery: shippingCost above is the courier price.
  pickupPointCost       Decimal @default(19.90) @db.Decimal(10, 2)
  courierEtaDays        String  @default("3-5")
  pickupEtaDays         String  @default("2-4")

  // Business details shown in the footer and legal pages (placeholders until registered).
  businessName          String  @default("BAIA Swimwear")
  companyId             String  @default("000000000")
  businessAddress       String  @default("מושב גילת")
  businessPhone         String  @default("050-0000000")
  contactEmail          String  @default("baiaswimwear0@gmail.com")
  whatsappNumber        String? @default("972500000000")
  accessibilityCoordinatorName  String @default("יעודכן בקרוב")
  accessibilityCoordinatorPhone String @default("050-0000000")
  accessibilityCoordinatorEmail String @default("baiaswimwear0@gmail.com")

  // Stock alerts: a variant at or below this quantity is "low stock".
  lowStockThreshold Int @default(5)

  @@map("site_config")
}


// ─── Delivery ─────────────────────────────────────────────────

/// A collection point shoppers can choose at checkout (managed in admin).
model PickupPoint {
  id        String   @id @default(cuid())
  name      String
  city      String
  address   String
  hours     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pickup_points")
}

// ─── Cancellations ────────────────────────────────────────────

enum CancellationStatus {
  REQUESTED      // waiting for the store to contact the customer
  APPROVED       // store cancelled the order
  REJECTED       // store declined (e.g. already shipped); note explains
  AUTO_CANCELLED // customer cancelled instantly inside the self-service window
}

model CancellationRequest {
  id           String             @id @default(cuid())
  orderId      String
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status       CancellationStatus @default(REQUESTED)
  reason       String
  details      String?
  contactPhone String?
  adminNote    String?
  // Fee charged under the consumer-protection rules (0 inside the free window).
  feeAmount    Decimal            @default(0) @db.Decimal(10, 2)
  refundAmount Decimal?           @db.Decimal(10, 2)
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([orderId])
  @@map("cancellation_requests")
}

// ─── Contact & marketing ──────────────────────────────────────

enum ContactMessageStatus {
  NEW
  HANDLED
}

model ContactMessage {
  id          String               @id @default(cuid())
  name        String
  email       String
  phone       String?
  orderNumber String?
  subject     String?
  message     String
  locale      String               @default("he")
  status      ContactMessageStatus @default(NEW)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

/// Marketing opt-ins (newsletter form, checkout or registration).
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("he")
  source         String    // "footer" | "checkout" | "register"
  consentAt      DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("newsletter_subscribers")
}

// ─── Email log ────────────────────────────────────────────────

enum EmailLogStatus {
  SENT
  FAILED
}

/// Every transactional email we tried to send (for support and auditing).
model EmailLog {
  id        String         @id @default(cuid())
  template  String
  to        String
  subject   String
  locale    String
  orderId   String?
  status    EmailLogStatus
  attempts  Int            @default(1)
  error     String?
  createdAt DateTime       @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@map("email_logs")
}
