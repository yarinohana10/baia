# Database
POSTGRES_USER=baia
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=baia

# Auth — REQUIRED in production, server refuses to start without a strong value.
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-a-random-secret-here
# Share the session cookie between the shop and API subdomains (e.g. .baiaswimwear.com)
AUTH_COOKIE_DOMAIN=.baiaswimwear.com

# URLs (update with your domain)
SERVER_URL=https://api.baiaswimwear.com
CLIENT_URL=https://baiaswimwear.com

# Email (SMTP — any provider: SES SMTP, Postmark, Resend, Mailgun, ...)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BAIA Swimwear <no-reply@baiaswimwear.com>"
