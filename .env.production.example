# Values for docker-compose.prod.yml (self-hosted). For Railway use docs/railway-env.md.
# Copy to .env.production (git-ignored) and fill in. NEVER commit real values.

POSTGRES_USER=baia
POSTGRES_PASSWORD=
POSTGRES_DB=baia

# Public storefront origin (https). The API is proxied under it.
SITE_URL=https://baia.co.il

# >= 32 random chars: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The business owner's email: pinned as the Owner (the only Admin who can add/remove Admins).
OWNER_EMAIL=yarinohana9@gmail.com

# Email - see docs/DEPLOYMENT.md "Email" (Gmail App Password quick start, or Resend/Postmark)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BAIA Swimwear <baiaswimwear0@gmail.com>"
ADMIN_NOTIFY_EMAIL=baiaswimwear0@gmail.com

# S3-compatible bucket for product images (Cloudflare R2 example)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://images.baia.co.il
S3_PUBLIC_URL_INCLUDES_BUCKET=false
S3_REGION=auto
S3_BUCKET=baia-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
IMAGE_REMOTE_PATTERNS=https://images.baia.co.il

# REQUIRED. Only "mock" exists today and it does NOT charge cards.
PAYMENT_PROVIDER=mock
# false = checkout shows "payments coming soon" and no order can be placed. Set true only with a real provider
# (or on a private staging site that tests the mock flow).
PAYMENTS_ENABLED=false

# Optional error reporting (Sentry free tier). Leave empty to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Database backups (scripts/backup-db.sh): a PRIVATE bucket, never the public image bucket.
BACKUP_S3_BUCKET=baia-backups
# BACKUP_S3_ENDPOINT / BACKUP_S3_ACCESS_KEY / BACKUP_S3_SECRET_KEY fall back to S3_* when unset.
