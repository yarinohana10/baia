# Settings for docker-compose.railway-sim.yml. Copy to .env.railsim (git-ignored) and edit:
#   cp .env.railsim.example .env.railsim
# Pass it to compose with:  docker compose -p baia-railsim --env-file .env.railsim -f docker-compose.railway-sim.yml ...
# NEVER commit .env.railsim and never paste a real key into this example file.

# Owner = the pinned Admin (register this address on the sim site and verify it).
OWNER_EMAIL=owner@baia-railsim.test
# Store inbox for new-order alerts.
ADMIN_NOTIFY_EMAIL=store@baia-railsim.test

# ── Default: emails go to Mailpit (docker-compose.infra.yml) at http://localhost:8025 ──
EMAIL_FROM="BAIA Swimwear <orders@baia-railsim.test>"

# ── Optional: REAL email through Resend. Uncomment all five lines and fill in ──
# The sender domain must be verified in Resend; use the same address as EMAIL_FROM.
# Use a throwaway/test API key here, not the production one.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="BAIA Swimwear <orders@your-domain.com>"
